# Copia este fichero a `.env` y rellena las cinco claves.
# `.env` está ignorado por git: al desplegar hay que declararlas en el panel
# del proveedor, porque no viajan con el código.
#
# Nada que lleve el prefijo `NEXT_PUBLIC_` es secreto: el bundler lo sustituye
# en tiempo de compilación y viaja al navegador. Una clave secreta detrás de ese
# prefijo queda publicada.

# Clave de API de Resend, del panel https://resend.com/api-keys
RESEND_API_KEY=

# Buzón que recibe los mensajes del formulario de /about.
# Mientras el remitente sea el de pruebas `onboarding@resend.dev`, tiene que ser
# exactamente el correo dueño de la cuenta de Resend: cualquier otra dirección
# hace que Resend responda 403 y el formulario falle siempre.
CONTACT_TO_EMAIL=

# --- Supabase (proyecto vrepjeurrsaekrosmuye) ---

# Contraseña de la base de datos, de Project Settings → Database.
# La usa la CLI (`supabase link`, `npm run db:push`); no la lee la aplicación.
# Es secreta: nunca la pongas detrás de `NEXT_PUBLIC_`.
SUPABASE_DB_PASSWORD=

# URL de la API del proyecto: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (`sb_publishable_…`), de Project Settings → API Keys.
# Usa la publicable, no la clave `anon` heredada: se rota de forma independiente
# y es la recomendada para proyectos nuevos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
